.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Agent operational state (see CLAUDE.md); .omc/skills is the committable exception
.omc/
!.omc/skills/

# asdf toolchain pin
# .tool-versions is intentionally committed

# Machine-local Claude Code settings and their temp files
.claude/settings.local.json
.claude/*.tmp.*
