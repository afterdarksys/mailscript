# Binaries (root level only, not cmd/mailscript directory)
/mailscript
*.exe
*.dll
*.so
*.dylib
cmd/mailscript/mailscript

# Distribution
dist/
*.tar.gz
*.zip

# Test output
*.mbox
*.maildir
test-results/

# Go
*.test
*.out

# go.sum is deliberately NOT ignored. It pins the checksum of every module in
# the build, so an altered or substituted dependency fails verification rather
# than being compiled in silently.

